# fastlane-Fastfile — DRIFT iOS lanes (match / gym / pilot).
#
# TIER + PLATFORM NOTE: iOS is DESIGN-LEVEL in this Weapon. The Linux dev VM (AGENTS.md) cannot
# compile or sign an iOS build — that requires macOS + Xcode. PROJECT-DRIFT is also mid-Tier-0
# (no scene to build, AGENTS.md), and device builds are run by the HUMAN (CLAUDE.md §7). This
# Fastfile is the SHAPE the human runs on a Mac in Tier 1, not a CI lane this environment executes.
#
# The build pipeline ends at the .ipa / the TestFlight upload. App Store Connect METADATA, ASO,
# privacy nutrition labels, review, and IAP belong to app-store-submission-guardian — `deliver`
# (metadata) is intentionally NOT a lane here; that crosses the lane boundary.
#
# Place at: fastlane/Fastfile (alongside fastlane/Appfile, fastlane/Matchfile).
# Workflow precondition: Unity emits the Xcode project (BuildScript.BuildIosRelease, guides/06),
# then these lanes build/sign/upload it.

default_platform(:ios)

platform :ios do
  # Sync signing identity from the encrypted match repo (guides/04 §3). Use match (not per-machine
  # manual signing) so every Mac / CI runner reproduces the exact certs + provisioning profiles.
  desc "Sync signing certs & provisioning profiles (read-only)"
  lane :signing do
    match(type: "appstore", readonly: true)
  end

  # Archive the Unity-generated Xcode project into a signed .ipa. Bitcode is deprecated/removed in
  # the modern Xcode era (guides/04 §5) — leave it disabled (patch ENABLE_BITCODE=NO via PBXProject).
  desc "Build & archive the Unity Xcode project into a signed .ipa"
  lane :build do
    signing
    gym(
      project: "Unity-iPhone.xcodeproj",     # generated by Unity under build/iOS
      scheme: "Unity-iPhone",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/iOS/ipa",
      output_name: "drift.ipa",
      clean: true
    )
  end

  # Upload to TestFlight. This is the END of the build pipeline's iOS lane — beta config, review,
  # and store metadata are app-store-submission-guardian's domain.
  desc "Upload the .ipa to TestFlight"
  lane :beta do
    build
    pilot(
      ipa: "build/iOS/ipa/drift.ipa",
      skip_waiting_for_build_processing: true
    )
  end

  # NOTE: `deliver` (store metadata/screenshots/release) is intentionally OMITTED — that is
  # app-store-submission-guardian's lane. This Weapon hands over the signed .ipa / TestFlight build.
end
