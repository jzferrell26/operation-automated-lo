# Copy to .env and fill in. GITIGNORE the real .env. Tokens are read from env ONLY,
# never logged, never passed on the command line, never committed (see guides/02-auth-token-resolution.md).

# GoHighLevel / LeadConnector - SUB-ACCOUNT (location) PIT, NOT an agency token.
# Scopes: socialplanner/account.readonly + socialplanner/post.write
GHL_SUBACCOUNT_PIT=
GHL_LOCATION_ID=
# Pin the verified version; v3 exists in marketplace docs but is not adopted blindly.
GHL_API_VERSION=2021-07-28

# Zernio - simple API key (Bearer). Base https://zernio.com/api/v1 ; MCP https://mcp.zernio.com/mcp
ZERNIO_API_KEY=

# Optional alt providers (verify draft semantics live before use)
AYRSHARE_API_KEY=
BLOTATO_API_KEY=
POSTIZ_API_KEY=
POSTIZ_BASE_URL=
MIXPOST_API_KEY=
MIXPOST_BASE_URL=
