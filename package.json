{
  "name": "operation-automated-lo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.15.1"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "lint": "oxlint apps packages tests tooling",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.tooling.json",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "test:db": "node tooling/scripts/database/run-real-database-tests.mjs",
    "test:contracts": "vitest run --project contracts",
    "test:components": "vitest run --project components",
    "test:visual": "vitest run --project visual",
    "test:e2e:preview": "vitest run --project e2e-preview",
    "test:browser:install": "playwright install chromium",
    "test:browser": "playwright test --config playwright.config.ts",
    "tasks:local": "pnpm --filter @oalo/tasks run run:local",
    "jscpd": "jscpd --config jscpd.json",
    "audit:boundaries": "node tooling/scripts/audit-boundaries.mjs && node tooling/scripts/audit-boundaries.mjs --assert-reject tooling/fixtures/boundaries/reverse-dependency.json",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "audit:product-types": "node tooling/scripts/audit-product-types.mjs",
    "audit:secrets": "node tooling/scripts/audit-secrets.mjs",
    "ghl:g2-matrix": "node tooling/scripts/ghl/run-g2-app-test-matrix.mjs",
    "verify:offline": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:contracts && pnpm test:components && pnpm test:visual && pnpm test:e2e:preview && pnpm test:browser && pnpm jscpd && pnpm audit:boundaries && pnpm audit:product-types && pnpm audit:secrets && pnpm audit:dependencies && pnpm build",
    "verify": "pnpm verify:offline && pnpm test:db"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "4.1.11",
    "jscpd": "5.3.0",
    "jsdom": "29.1.1",
    "oxlint": "1.83.0",
    "prettier": "3.9.8",
    "sharp": "0.35.4",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "typescript-compat": "npm:typescript@6.0.3",
    "vitest": "4.1.11",
    "zod": "4.6.5"
  }
}
