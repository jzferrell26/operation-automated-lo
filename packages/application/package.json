{
  "name": "@oalo/application",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./homeowner-reports": {
      "types": "./src/homeowner-reports.ts",
      "default": "./dist/homeowner-reports.js"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oalo/contracts": "workspace:*",
    "@oalo/domain": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
