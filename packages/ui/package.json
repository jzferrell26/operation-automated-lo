{
  "name": "@oalo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./components.css": "./dist/components.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node ./scripts/prepare-dist.mjs && tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "test:components": "vitest run --config ./scripts/vitest.config.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "4.1.11"
  }
}
