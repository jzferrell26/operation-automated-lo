{
  "name": "@oalo/rendering",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./funnel-photo": {
      "types": "./src/funnel-photo.ts",
      "default": "./dist/funnel-photo.js"
    },
    "./qr": {
      "types": "./src/render-evidence.ts",
      "default": "./dist/render-evidence.js"
    },
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oalo/application": "workspace:*",
    "@oalo/contracts": "workspace:*",
    "@playwright/test": "1.63.0",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/qrcode": "1.5.6"
  }
}
