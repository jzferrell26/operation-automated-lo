{
  "name": "@oalo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "test:postgres": "tsc -p tsconfig.json && node --test test/postgres-adapter.integration.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@oalo/contracts": "workspace:*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "catalog:"
  }
}
